/* 今天页：颜色走 app.wxss 的 CSS 变量（.page-root），这里只写布局差异 */

.hero { margin-bottom: 32rpx; }
.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-s { font-size: 26rpx; color: var(--text3); margin-top: 10rpx; }

/* 组间休息：纯色陶土橙（用户要求纯色填充，不用黑块） */
.rest-panel {
  background: var(--accent); color: #fff;
  border-radius: 28rpx; padding: 32rpx;
  text-align: center; margin-bottom: 24rpx;
}
.rest-t { font-size: 24rpx; opacity: 0.85; letter-spacing: 4rpx; }
.rest-num { font-size: 80rpx; font-weight: 700; font-variant-numeric: tabular-nums; margin: 8rpx 0 16rpx; }
.rest-bar { height: 8rpx; background: rgba(255,255,255,0.35); border-radius: 4rpx; overflow: hidden; }
.rest-fill { height: 100%; background: #fff; transition: width 1s linear; }

/* 全部完成 */
.done-panel {
  background: var(--success); color: #fff;
  border-radius: 20rpx; padding: 28rpx;
  text-align: center; font-size: 28rpx; margin-bottom: 24rpx;
}

/* 动作卡片 */
.ex { padding: 28rpx; }
.ex-video {
  width: 100%; height: 400rpx;
  border-radius: 24rpx; overflow: hidden;
  background: var(--accent-bg); margin-bottom: 20rpx;
  display: block;
}
.ex-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8rpx; }
.ex-name { font-size: 30rpx; font-weight: 600; }
.ex-count { font-size: 22rpx; color: var(--text3); }
.ex-note { font-size: 22rpx; color: var(--text3); margin-bottom: 16rpx; line-height: 1.6; }

/* 组 */
.set-list { display: flex; flex-direction: column; }
.set-row {
  display: flex; align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--line);
}
.set-row:first-child { border-top: none; }
.set-lb { font-size: 26rpx; font-weight: 500; min-width: 110rpx; }
.set-detail { font-size: 24rpx; color: var(--text2); flex: 1; }
.set-check {
  width: 56rpx; height: 56rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--text3);
}
.set-check.on {
  background: var(--accent); border-color: var(--accent); color: #fff;
}
