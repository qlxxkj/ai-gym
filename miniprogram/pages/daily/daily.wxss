/* 今天页：统一设计系统（见 app.wxss），本页只写差异 */

.hero { margin-bottom: 32rpx; }
.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-s { font-size: 26rpx; color: #A2968D; margin-top: 10rpx; }

/* 休息倒计时 */
.rest-panel {
  background: #1C1715; color: #fff;
  border-radius: 28rpx; padding: 32rpx;
  text-align: center; margin-bottom: 24rpx;
}
.rest-t { font-size: 24rpx; opacity: 0.7; letter-spacing: 4rpx; }
.rest-num { font-size: 80rpx; font-weight: 700; font-variant-numeric: tabular-nums; margin: 8rpx 0 16rpx; }
.rest-bar { height: 8rpx; background: rgba(255,255,255,0.2); border-radius: 4rpx; overflow: hidden; }
.rest-fill { height: 100%; background: #B0532E; transition: width 1s linear; }

/* 全部完成 */
.done-panel {
  background: #3F7D4E; color: #fff;
  border-radius: 20rpx; padding: 28rpx;
  text-align: center; font-size: 28rpx; margin-bottom: 24rpx;
}

/* 动作卡片 */
.ex { padding: 28rpx; }
.ex-video {
  width: 100%; height: 320rpx;
  border-radius: 24rpx; overflow: hidden;
  background: #F4F0EA; margin-bottom: 20rpx;
  display: block;
}
.ex-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8rpx; }
.ex-name { font-size: 30rpx; font-weight: 600; }
.ex-count { font-size: 22rpx; color: #A2968D; }
.ex-note { font-size: 22rpx; color: #A2968D; margin-bottom: 16rpx; line-height: 1.6; }

/* 组 */
.set-list { display: flex; flex-direction: column; }
.set-row {
  display: flex; align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid #EAE3DC;
}
.set-row:first-child { border-top: none; }
.set-lb { font-size: 26rpx; font-weight: 500; min-width: 110rpx; }
.set-detail { font-size: 24rpx; color: #6E625B; flex: 1; }
.set-check {
  width: 56rpx; height: 56rpx;
  border: 2rpx solid #EAE3DC;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #A2968D;
}
.set-check.on {
  background: #B0532E; border-color: #B0532E; color: #fff;
}
