<view class="page page--tab {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_daily" />
  <block wx:if="{{!plan}}">
    <view class="state">
      <view class="state__text">{{!loading ? T.daily_empty_s : T.daily_loading}}</view>
      <view class="state__text" wx:if="{{!loading}}" style="margin-top:var(--s-2);color:var(--ink-2);font-size:var(--t-body)">{{T.daily_empty_t}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="hero hero--lead">
      <view class="hero__title" style="font-size:var(--t-title);letter-spacing:2rpx">{{dayLabel}}</view>
      <view class="hero__desc">{{today}} · {{T.daily_sub}}{{langEn ? (plan.title_en || plan.title) : plan.title}}{{T.daily_sub_end}}</view>
    </view>

    <view class="rest rise" wx:if="{{restLeft > 0}}">
      <view class="rest__lb">{{T.daily_rest}}</view>
      <view class="rest__num">{{restLeft}}</view>
      <view class="rest__bar"><view class="rest__fill" style="width: {{restLeft / restTotal * 100}}%"></view></view>
    </view>

    <view class="done rise" wx:if="{{allDone}}" bindtap="markAllDone">{{T.daily_all_done}}</view>

    <view class="card ex rise-item" wx:for="{{exercises}}" wx:for-item="ex" wx:for-index="exidx" wx:key="id">
      <video wx:if="{{ex.clip_url}}" class="ex__media" src="{{ex.clip_url}}"
        loop="{{true}}" controls="{{false}}" autoplay="{{true}}" muted="{{true}}"
        show-center-play-btn="{{false}}" object-fit="cover"></video>
      <image wx:elif="{{ex.img_url}}" class="ex__media" src="{{ex.img_url}}" mode="aspectFill"></image>
      <view class="ex__head">
        <text class="ex__name">{{ex.name_zh}}</text>
        <text class="ex__count">{{ex.sets.length}} {{T.daily_sets_u}}</text>
        <view class="ex__fav {{ex.faved ? 'ex__fav--on' : ''}}" data-ex="{{ex}}" bindtap="toggleExFav">
          <view class="ic {{ex.faved ? 'ic-heart-fill' : 'ic-heart'}} {{ex.faved ? 'ic--acc' : ''}} ex__fav-ic"></view>
        </view>
      </view>
      <view class="ex__note" wx:if="{{ex.note}}">{{ex.note}}</view>
      <view class="set" wx:for="{{ex.sets}}" wx:for-item="st" wx:for-index="setidx" wx:key="*this">
        <text class="set__lb">{{T.daily_set}} {{setidx + 1}}</text>
        <text class="set__detail">{{st.reps}} {{T.daily_reps_u}} · {{st.rest_seconds}} {{T.daily_sec_u}}</text>
        <view class="set__check {{ex.setStates[setidx] ? 'set__check--on' : ''}}"
          data-exidx="{{exidx}}" data-setidx="{{setidx}}" bindtap="toggleSet">
          {{ex.setStates[setidx] ? '✓' : '○'}}
        </view>
      </view>
    </view>
  </block>
</view>
