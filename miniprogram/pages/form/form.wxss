/* 需求页：统一设计系统（见 app.wxss），本页只写差异 */
.hero { margin-bottom: 48rpx; }
.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-s { font-size: 26rpx; color: #A2968D; margin-top: 12rpx; }
.sec { margin-bottom: 40rpx; }
.sec-t { margin-bottom: 24rpx; }

.notes {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid #EAE3DC;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #1C1715;
}

.submit {
  margin-top: 16rpx;
  width: 100%;
  box-sizing: border-box;
  background: #B0532E;
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
}
.submit[disabled] { opacity: 0.5; }
