/* .hero/.card/.chips/.tag/.section-title/.btn/.rise 已在 app.wxss，本页只写差异 */

.sec { padding: 0 var(--s-4); }
.sec__t {
  padding: var(--s-4) 0 var(--s-3);
  font-size: var(--t-cap);
  letter-spacing: 2rpx;
  color: var(--ink-3);
}
.sec-notes { margin-top: var(--s-5); }

.notes {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: var(--s-3);
  background: var(--card);
  border-radius: var(--r-md);
  font-size: var(--t-sm);
  color: var(--ink);
  box-shadow: var(--shadow);
  line-height: 1.6;
}
