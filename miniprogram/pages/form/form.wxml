<view class="page {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_form" />
  <view class="hero">
    <view class="hero__title" style="font-size:var(--t-title);letter-spacing:2rpx">{{T.form_title}}</view>
    <view class="hero__desc">{{T.form_sub}}</view>
  </view>

  <view class="card sec rise" wx:for="{{secs}}" wx:key="id">
    <view class="sec__t">{{item.label}}</view>
    <view class="chips">
      <view wx:if="{{item.kind === 'single'}}"
        wx:for="{{item.values}}" wx:for-item="v" wx:for-index="i" wx:key="*this"
        class="chip {{item.active === i ? 'chip--on' : ''}}"
        data-field="{{item.field}}" data-i="{{i}}" bindtap="pick">{{v}}</view>
      <block wx:if="{{item.kind !== 'single'}}">
        <view wx:for="{{item.values}}" wx:for-item="v" wx:key="*this"
          class="chip {{item.checked[v] ? 'chip--on' : ''}}"
          data-m="{{v}}" bindtap="toggleFocus">{{v}}</view>
      </block>
    </view>
  </view>

  <view class="sec-notes">
    <view class="section-title">{{T.form_notes}}</view>
    <textarea class="notes" placeholder="{{T.form_notes_ph}}" value="{{notes}}" bindinput="onNotes" />
  </view>

  <button class="btn btn--accent btn--block rise" style="margin-top:var(--s-5)" disabled="{{generating}}" bindtap="submit">
    {{generating ? T.form_submit_ing : T.form_submit}}
  </button>
</view>
