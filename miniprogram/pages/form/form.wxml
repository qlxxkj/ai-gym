<view class="page">
  <view class="hero">
    <view class="hero-t">你的训练计划</view>
    <view class="hero-s">选几个选项，AI 为你定制专属计划</view>
  </view>

  <view class="sec">
    <view class="sec-t">目标</view>
    <view class="chips">
      <view wx:for="{{goals}}" wx:key="*this"
        class="chip {{goalIndex === index ? 'chip-on' : ''}}"
        data-field="goalIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">水平</view>
    <view class="chips">
      <view wx:for="{{levels}}" wx:key="*this"
        class="chip {{levelIndex === index ? 'chip-on' : ''}}"
        data-field="levelIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">每周训练次数</view>
    <view class="chips">
      <view wx:for="{{freqs}}" wx:key="*this"
        class="chip {{freqIndex === index ? 'chip-on' : ''}}"
        data-field="freqIndex" data-i="{{index}}" bindtap="pick">{{item}} 次</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">单次时长</view>
    <view class="chips">
      <view wx:for="{{times}}" wx:key="*this"
        class="chip {{timeIndex === index ? 'chip-on' : ''}}"
        data-field="timeIndex" data-i="{{index}}" bindtap="pick">{{item}} 分钟</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">可用器材</view>
    <view class="chips">
      <view wx:for="{{equipments}}" wx:key="*this"
        class="chip {{equipIndex === index ? 'chip-on' : ''}}"
        data-field="equipIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">重点肌群（可多选）</view>
    <view class="chips">
      <view wx:for="{{focusMuscles}}" wx:key="*this"
        class="chip {{focusChecked[item] ? 'chip-on' : ''}}"
        data-m="{{item}}" bindtap="toggleFocus">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">补充说明（伤病、偏好等）</view>
    <textarea class="notes" placeholder="例如：膝盖旧伤，避免深蹲；偏好徒手训练" value="{{notes}}" bindinput="onNotes" />
  </view>

  <button class="submit" disabled="{{generating}}" bindtap="submit">
    {{generating ? 'AI 制定中...' : '生成我的训练计划'}}
  </button>
</view>
