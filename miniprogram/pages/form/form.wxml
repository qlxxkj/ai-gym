<view class="page-root {{dark?'dark':''}}">
  <view class="page">
  <view class="hero">
    <view class="hero-t">{{i18n.formTitle}}</view>
    <view class="hero-s">{{i18n.formSub}}</view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formGoal}}</view>
    <view class="chips">
      <view wx:for="{{goals}}" wx:key="*this"
        class="chip {{goalIndex === index ? 'chip-on' : ''}}"
        data-field="goalIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formLevel}}</view>
    <view class="chips">
      <view wx:for="{{levels}}" wx:key="*this"
        class="chip {{levelIndex === index ? 'chip-on' : ''}}"
        data-field="levelIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formFreq}}</view>
    <view class="chips">
      <view wx:for="{{freqs}}" wx:key="*this"
        class="chip {{freqIndex === index ? 'chip-on' : ''}}"
        data-field="freqIndex" data-i="{{index}}" bindtap="pick">{{item}} {{i18n.formTimesUnit}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formTime}}</view>
    <view class="chips">
      <view wx:for="{{times}}" wx:key="*this"
        class="chip {{timeIndex === index ? 'chip-on' : ''}}"
        data-field="timeIndex" data-i="{{index}}" bindtap="pick">{{item}} {{i18n.formTimeUnit}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formEquip}}</view>
    <view class="chips">
      <view wx:for="{{equipments}}" wx:key="*this"
        class="chip {{equipIndex === index ? 'chip-on' : ''}}"
        data-field="equipIndex" data-i="{{index}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formFocus}}</view>
    <view class="chips">
      <view wx:for="{{focusMuscles}}" wx:key="*this"
        class="chip {{focusChecked[item] ? 'chip-on' : ''}}"
        data-m="{{item}}" bindtap="toggleFocus">{{item}}</view>
    </view>
  </view>

  <view class="sec">
    <view class="sec-t">{{i18n.formNotes}}</view>
    <textarea class="notes" placeholder="{{i18n.formNotesPh}}" value="{{notes}}" bindinput="onNotes" />
  </view>

  <button class="submit" disabled="{{generating}}" bindtap="submit">
    {{generating ? i18n.formSubmitIng : i18n.formSubmit}}
  </button>
  </view>
</view>
