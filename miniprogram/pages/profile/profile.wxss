/* .hero* / .card / .row* / .section-title / .ic* 已在 app.wxss。本页只写差异 */

/* ---------- 头部：头像 + 昵称 ---------- */
.me {
    display: flex;
    align-items: center;
    padding: var(--s-5) var(--s-4);
}

.me__avatar-btn {
    position: relative;
    display: block;
    width: 132rpx;
    height: 132rpx;
    flex: 0 0 132rpx;
    padding: 0;
    border-radius: 50%;
    overflow: visible;
}

.me__avatar {
    display: block;
    width: 132rpx;
    height: 132rpx;
    border-radius: 50%;
    background: var(--fill);
}
.me__avatar-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56rpx;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-bg);
}

/* 小角标，提示头像可点 */
.me__badge {
    position: absolute;
    right: -6rpx;
    bottom: -6rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48rpx;
    height: 48rpx;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 2rpx 10rpx rgba(36, 29, 27, 0.14);
}
.me__badge-ic {
    width: 28rpx;
    height: 28rpx;
    --ic: var(--ink-3);
}

.me__info {
    flex: 1;
    min-width: 0;
    margin-left: var(--s-3);
}
.me__name {
    font-size: var(--t-title);
    font-weight: 600;
    letter-spacing: 1rpx;
    color: var(--ink);
}
.me__stat {
    margin-top: var(--s-1);
    font-size: var(--t-cap);
    color: var(--ink-3);
}

/* ---------- 收藏分组小标题（顶到行的图标位，与下方行的图标左对齐） ---------- */
.group-lb {
    padding: var(--s-3) calc(var(--s-4) + 46rpx) var(--s-1);
    font-size: var(--t-cap);
    letter-spacing: 2rpx;
    color: var(--ink-3);
}

/* ---------- 设置行：与分享行一致的两段式（左 图标+文字，右 选项） ---------- */
.row--set {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
}
.row--set .row__label { flex: none; }
.row__chips {
    display: flex;
    gap: var(--s-1);
    flex: none;
}

/* ---------- 空态图标 ---------- */
.state__ic {
    width: 72rpx;
    height: 72rpx;
    margin: 0 auto var(--s-3);
    opacity: 0.5;
}

/* ---------- 分享行：button 只做触发，布局交给 view ---------- */
.row__share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 112rpx;
    padding: 0 var(--s-4);
}
.row__share-btn {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 0;
    margin: 0;
    background: transparent;
    font-weight: 400;
    text-align: left;
}
.row__share-btn::after { border: none; }
.row__lead {
    display: flex;
    align-items: center;
    min-width: 0;
}

/* ---------- 页脚 ---------- */
.about {
    margin-top: var(--s-7);
    text-align: center;
}
.about__brand {
    font-size: var(--t-title);
    letter-spacing: 6rpx;
    color: var(--ink-3);
    font-weight: 600;
}
.about__desc {
    margin-top: var(--s-2);
    font-size: var(--t-cap);
    color: var(--ink-3);
}
