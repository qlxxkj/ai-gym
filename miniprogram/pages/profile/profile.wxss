/* .hero* / .card / .row* / .section-title / .ic* 已在 app.wxss。本页只写差异 */

/* ---------- 头部：头像 + 昵称 ---------- */
.me {
    display: flex;
    align-items: center;
    padding: var(--s-5) var(--s-4);
}

.me__avatar-btn {
    position: relative;
    display: block;
    width: 132rpx;
    height: 132rpx;
    flex: 0 0 132rpx;
    padding: 0;
    border-radius: 50%;
    overflow: visible;
}

.me__avatar {
    display: block;
    width: 132rpx;
    height: 132rpx;
    border-radius: 50%;
    background: var(--fill);
}
.me__avatar-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56rpx;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-bg);
}

/* 小角标，提示头像可点 */
.me__badge {
    position: absolute;
    right: -6rpx;
    bottom: -6rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48rpx;
    height: 48rpx;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 2rpx 10rpx rgba(36, 29, 27, 0.14);
}
.me__badge-ic {
    width: 28rpx;
    height: 28rpx;
    --ic: var(--ink-3);
}

.me__info {
    flex: 1;
    min-width: 0;
    margin-left: var(--s-3);
}
.me__name {
    font-size: var(--t-title);
    font-weight: 600;
    letter-spacing: 1rpx;
    color: var(--ink);
}
.me__stat {
    margin-top: var(--s-1);
    font-size: var(--t-cap);
    color: var(--ink-3);
}

/* ---------- 行右侧尾巴：当前值/数量 + 箭头，左段与右段对齐 ---------- */
.row__tail {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
}
.row__tail .row__value {
    flex: none;
    margin-left: 0;
}

/* ---------- 弹层：收藏明细 / 设置选档 ---------- */
.sheet__mask {
    position: fixed;
    left: 0; top: 0; right: 0; bottom: 0;
    background: var(--mask);
    z-index: 99;
    display: flex;
    align-items: flex-end;
}
.sheet {
    width: 100%;
    box-sizing: border-box;
    background: var(--card);
    color: var(--ink);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding: var(--s-5) var(--s-4) calc(var(--s-5) + 104rpx + env(safe-area-inset-bottom));
    max-height: 70vh;
    overflow-y: auto;
}
.sheet__t { font-size: var(--t-title); font-weight: 600; text-align: center; margin-bottom: var(--s-3); }
.sheet__empty {
    padding: var(--s-5) 0;
    text-align: center;
    font-size: var(--t-sm);
    color: var(--ink-3);
}

/* 设置弹层选项行 */
.opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 112rpx;
    padding: 0 var(--s-3);
    border-bottom: 1rpx solid var(--line);
}
.opt:last-child { border-bottom: none; }
.opt__lb { font-size: var(--t-body); color: var(--ink); }
.opt__check { font-size: var(--t-body); font-weight: 700; color: var(--accent); }

/* ---------- 页脚 ---------- */
.about {
    margin-top: var(--s-7);
    text-align: center;
}
.about__brand {
    font-size: var(--t-title);
    letter-spacing: 6rpx;
    color: var(--ink-3);
    font-weight: 600;
}
.about__desc {
    margin-top: var(--s-2);
    font-size: var(--t-cap);
    color: var(--ink-3);
}
