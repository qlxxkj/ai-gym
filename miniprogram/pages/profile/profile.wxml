<view class="page page--tab {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_profile" />
  <!-- ---------- 头像 / 昵称 ---------- -->
  <view class="card me rise">
    <view class="me__avatar-btn" bindtap="pickAvatar">
      <image wx:if="{{avatar}}" class="me__avatar" src="{{avatar}}" mode="aspectFill"></image>
      <view wx:else class="me__avatar me__avatar-ph">{{nick ? nick[0] : '?'}}</view>
      <view class="me__badge"><view class="ic ic-camera me__badge-ic"></view></view>
    </view>
    <view class="me__info">
      <view class="me__name" bindtap="pickNick">{{nick}}</view>
      <view class="me__stat">{{T.mine_faved_prefix}}{{favCount}}{{T.mine_faved_suffix}}</view>
    </view>
  </view>

  <!-- ---------- 我的收藏：一张卡，行内小标题分两组 ---------- -->
  <view class="section-title section-title--gap">{{T.sec_fav}}</view>
  <view class="card group rise">
    <block wx:if="{{favPlans.length || favExercises.length}}">
      <block wx:if="{{favPlans.length}}">
        <view class="group-lb">{{T.sec_fav_plans}}</view>
        <view class="row" wx:for="{{favPlans}}" wx:key="id" data-id="{{item.id}}" bindtap="openFavPlan">
          <view class="ic ic-book row__ic"></view>
          <text class="row__label">{{item.title}}</text>
          <text class="row__value">{{item.goal}}</text>
          <view class="ic ic-chevron row__arrow"></view>
        </view>
      </block>
      <block wx:if="{{favExercises.length}}">
        <view class="group-lb">{{T.sec_fav_ex}}</view>
        <view class="row" wx:for="{{favExercises}}" wx:key="id" data-id="{{item.id}}" bindtap="openFavEx">
          <view class="ic ic-dumbbell row__ic"></view>
          <text class="row__label">{{item.name}}</text>
          <view class="ic ic-chevron row__arrow"></view>
        </view>
      </block>
    </block>
    <block wx:else>
      <view class="state">
        <view class="ic ic-heart state__ic"></view>
        <view class="state__text">{{T.mine_fav_empty}}</view>
      </view>
    </block>
  </view>

  <!-- ---------- 我的设置：三档 chip，行内切换 ---------- -->
  <view class="section-title section-title--gap">{{T.sec_settings}}</view>
  <view class="card group rise">
    <view class="row row--set">
      <view class="row__lead"><view class="ic ic-sun row__ic"></view><text class="row__label">{{T.mine_appearance}}</text></view>
      <view class="row__chips">
        <view wx:for="{{themeOpts}}" wx:key="v"
          class="chip {{themePref === item.v ? 'chip--on' : ''}}"
          data-v="{{item.v}}" bindtap="pickThemeOpt">{{item.label}}</view>
      </view>
    </view>
    <view class="hr"></view>
    <view class="row row--set">
      <view class="row__lead"><view class="ic ic-lang row__ic"></view><text class="row__label">{{T.mine_text}}</text></view>
      <view class="row__chips">
        <view wx:for="{{langOpts}}" wx:key="v"
          class="chip {{langPref === item.v ? 'chip--on' : ''}}"
          data-v="{{item.v}}" bindtap="pickLangOpt">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- ---------- 分享 ---------- -->
  <view class="section-title section-title--gap">{{T.sec_share}}</view>
  <view class="card group rise">
    <view class="row row__share">
      <button class="row__share-btn" open-type="share">
        <view class="row__lead">
          <view class="ic ic-share row__ic"></view>
          <text class="row__label">{{T.share_friend}}</text>
        </view>
      </button>
      <view class="ic ic-chevron row__arrow"></view>
    </view>
  </view>

  <!-- ---------- 关于 ---------- -->
  <view class="section-title section-title--gap">{{T.sec_about}}</view>
  <view class="card group rise">
    <view class="row">
      <view class="ic ic-info row__ic"></view>
      <text class="row__label">{{T.about_version}}</text>
      <text class="row__value">{{version}}</text>
    </view>
  </view>

  <view class="about">
    <view class="about__brand">{{T.about_brand}}</view>
    <view class="about__desc">{{T.about_desc}}</view>
  </view>
</view>
