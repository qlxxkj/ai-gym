/* .hero/.card/.row/.state/.section-title/.btn/.ic* 已在 app.wxss */

/* 核心指标 2x2 */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-3);
  margin-bottom: var(--s-4);
}
.grid__cell {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: var(--s-4);
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(36, 29, 27, 0.05);
}
.grid__num {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.grid__lb {
  margin-top: var(--s-1);
  font-size: var(--t-cap);
  color: var(--ink-3);
}

.card { margin-bottom: var(--s-4); }

/* ===== 1RM 曲线 ===== */
.rm-chart { padding: var(--s-3) var(--s-4) var(--s-4); }
.rm-chart__area { position: relative; min-height: 300rpx; }
.rm-canvas { width: 100%; height: 300rpx; display: block; }
/* 降级条形图 */
.rm-bars { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-2) 0; }
.rm-bar { display: flex; align-items: center; gap: var(--s-2); }
.rm-bar__lb { font-size: var(--t-cap); color: var(--ink-2); width: 140rpx; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rm-bar__track { flex: 1; height: 16rpx; background: var(--fill); border-radius: 8rpx; overflow: hidden; }
.rm-bar__fill { height: 100%; background: var(--accent); border-radius: 8rpx; }
.rm-bar__val { font-size: var(--t-cap); color: var(--ink-3); width: 80rpx; text-align: right; font-variant-numeric: tabular-nums; }
/* 图例 */
.rm-legend { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: var(--s-2) 0 0; }
.rm-legend__item { display: flex; align-items: center; gap: 6rpx; }
.rm-legend__dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex: none; }
.rm-legend__lb { font-size: var(--t-cap); color: var(--ink-3); }

/* ===== 肌群地图 ===== */
.bodymap { display: flex; flex-direction: column; align-items: center; padding: var(--s-3) 0 var(--s-4); }
.bodymap__img { width: 200rpx; height: 400rpx; }
.bodymap__legend {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: var(--t-cap);
  color: var(--ink-3);
  margin-top: var(--s-2);
}
.bodymap__legend::before {
  content: "";
  display: inline-block;
  width: 120rpx;
  height: 8rpx;
  background: linear-gradient(to right, var(--accent), transparent);
  border-radius: 4rpx;
  vertical-align: middle;
}

/* ===== 肌群雷达图 ===== */
.radar { display: flex; justify-content: center; padding: var(--s-3) 0 var(--s-4); }
.radar__wrap {
  position: relative;
  width: 360rpx;
  height: 360rpx;
}
.radar__grid {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid var(--line);
}
.radar__ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  opacity: 0.5;
}
.radar__ring--1 { inset: 15%; }
.radar__ring--2 { inset: 30%; }
.radar__ring--3 { inset: 45%; }
/* 数据值：旋转 + 高度模拟六边形辐条 */
.radar__val {
  position: absolute;
  bottom: 50%;
  left: calc(50% - 4rpx);
  width: 8rpx;
  background: var(--accent);
  border-radius: 4rpx;
  opacity: 0.7;
  transform-origin: bottom center;
}
/* 标签层 */
.radar__labels { position: absolute; inset: 0; }
.radar__lb {
  position: absolute;
  font-size: 20rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ===== 周热力图 ===== */
.heat { padding: var(--s-3) var(--s-4) var(--s-4); }
.heat__row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.heat__cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--fill);
  flex: none;
}
.heat__cell--on {
  background: var(--accent);
  opacity: calc(0.15 + var(--pct) / 100 * 0.85);
}
.heat__note {
  font-size: var(--t-cap);
  color: var(--ink-3);
  margin-top: var(--s-2);
}

/* ===== 每周打卡柱状（保留） ===== */
.bars {
  display: flex;
  align-items: flex-end;
  gap: var(--s-2);
  padding: var(--s-3) 0 var(--s-2);
  height: 280rpx;
}
.bars__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-1);
  height: 100%;
}
.bars__num { font-size: 20rpx; color: var(--ink-3); }
.bars__track {
  flex: 1;
  width: 100%;
  max-width: 56rpx;
  background: var(--fill);
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.bars__fill {
  width: 100%;
  background: var(--accent);
  border-radius: 8rpx;
  min-height: 4rpx;
}
.bars__wk { font-size: 20rpx; color: var(--ink-3); }
.bars__note { font-size: var(--t-cap); color: var(--ink-3); padding: 0 var(--s-4) var(--s-3); }

/* ===== 常用动作行 ===== */
.ex__row { padding: var(--s-2) var(--s-4); border-top: 1rpx solid var(--line); }
.ex__row:first-of-type { border-top: none; }

/* ===== 体重 ===== */
.wt__head { padding: var(--s-4) var(--s-4) 0; }
.wt__head .row__value { display: flex; align-items: baseline; gap: var(--s-2); }
.wt__latest { color: var(--accent); font-weight: 700; font-size: var(--t-title); }
.wt__delta { font-size: var(--t-cap); }
.wt__delta--up { color: var(--ok); }
.wt__delta--dn { color: var(--err); }
.wt__row {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-3) var(--s-4) 0;
}
.wt__input {
  flex: 1;
  background: var(--fill);
  border-radius: var(--r-md);
  padding: var(--s-2) var(--s-3);
  font-size: var(--t-body);
}
.wt__btn { flex: none; }
/* 目标体重 */
.wt__target {
  padding: var(--s-2) var(--s-4) 0;
  background: var(--fill);
  border-radius: var(--r-md);
  margin: var(--s-2) var(--s-4) 0;
}
.wt__target__row {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) 0;
}
.wt__target__lb { font-size: var(--t-cap); color: var(--ink-3); flex: none; }
.wt__target__input { flex: 1; background: var(--card); }
.wt__target__diff { font-size: var(--t-cap); color: var(--ink-3); padding-top: var(--s-1); }
.wt__target__pct { margin-left: var(--s-1); }
.wt__note {
  padding: var(--s-3) var(--s-4) var(--s-4);
  font-size: var(--t-cap);
  color: var(--ink-3);
}
