<view class="page {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_stats" />

  <view class="state" wx:if="{{loading}}">
    <view class="state__text">{{T.loading}}</view>
  </view>

  <block wx:if="{{!loading && s}}">
    <!-- 核心指标 -->
    <view class="grid rise">
      <view class="grid__cell">
        <view class="grid__num">{{s.total_days}}</view>
        <view class="grid__lb">{{T.st_total_days}}</view>
      </view>
      <view class="grid__cell">
        <view class="grid__num">{{s.volume.sets}}</view>
        <view class="grid__lb">{{T.st_total_sets}}</view>
      </view>
      <view class="grid__cell">
        <view class="grid__num">{{s.volume.reps}}</view>
        <view class="grid__lb">{{T.st_total_reps}}</view>
      </view>
      <view class="grid__cell">
        <view class="grid__num">{{s.week7Max}}</view>
        <view class="grid__lb">{{T.st_week7}}</view>
      </view>
    </view>

    <!-- 1RM 曲线（top 4 动作，SVG polyline） -->
    <view class="card rise" wx:if="{{oneRm.length}}">
      <view class="section-title">{{T.st_1rm}}</view>
      <view class="rm-chart">
        <view class="rm-chart__area">
          <!-- 条形图（每条线一个动作，显示最新 1RM 值） -->
          <view class="rm-bars">
            <view class="rm-bar" wx:for="{{oneRm}}" wx:key="id">
              <text class="rm-bar__lb">{{item.name}}</text>
              <view class="rm-bar__track">
                <view class="rm-bar__fill" style="width: {{rmMaxY ? (item.pts.length ? (item.pts[item.pts.length - 1].y / rmMaxY * 100) : 0) : 0}}%"></view>
              </view>
              <text class="rm-bar__val">{{item.pts.length ? item.pts[item.pts.length - 1].y : ''}} kg</text>
            </view>
          </view>
        </view>
        <!-- 图例 -->
        <view class="rm-legend">
          <view class="rm-legend__item" wx:for="{{oneRm}}" wx:key="id">
            <view class="rm-legend__dot" style="background:{{rmColors[index]}}"></view>
            <text class="rm-legend__lb">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 肌群地图（人体轮廓，按训练量着色） -->
    <view class="card rise" wx:if="{{bodyMapUrl}}">
      <view class="section-title">{{T.st_bodymap}}</view>
      <view class="bodymap">
        <image class="bodymap__img" src="{{bodyMapUrl}}" mode="aspectFit" />
        <view class="bodymap__legend">
          <text class="bodymap__legend--lo">{{T.st_bodymap_lo}}</text>
          <text class="bodymap__legend--hi">{{T.st_bodymap_hi}}</text>
        </view>
      </view>
    </view>

    <!-- 肌群覆盖雷达图 -->
    <view class="card rise" wx:if="{{radar.length}}">
      <view class="section-title">{{T.st_radar}}</view>
      <view class="radar">
        <!-- 雷达图：用 CSS 六边形 + 填充实现（SVG polygon） -->
        <view class="radar__wrap">
          <!-- 背景六边形网格 -->
          <view class="radar__grid"></view>
          <!-- 数据多边形（view 叠层模拟） -->
          <view class="radar__ring radar__ring--1"></view>
          <view class="radar__ring radar__ring--2"></view>
          <view class="radar__ring radar__ring--3"></view>
          <!-- 数据填充层（每个部位一条） -->
          <view class="radar__val" wx:for="{{radar}}" wx:key="key" wx:for-item="r"
            style="transform: rotate({{r.angleDeg}}deg); height: {{r.pct * 0.5}}rpx">
          </view>
          <!-- 标签 -->
          <view class="radar__labels">
            <text class="radar__lb" wx:for="{{radar}}" wx:key="key" wx:for-item="r"
              style="top: {{r.top}}%; left: {{r.left}}%">
              {{r.lb}} · {{r.sets}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- 周热力图（近 26 周组数） -->
    <view class="card rise" wx:if="{{heatmap.length}}">
      <view class="section-title">{{T.st_heat}}</view>
      <view class="heat">
        <view class="heat__row">
          <view class="heat__cell {{item.sets ? 'heat__cell--on' : ''}}"
            wx:for="{{heatmap}}" wx:key="key"
            style="--pct:{{item.pct}}"
            data-week="{{item.key}}"
          >
          </view>
        </view>
        <view class="heat__note">{{T.st_heat_note}}</view>
      </view>
    </view>

    <!-- 每周打卡（保留原有柱状） -->
    <view class="card rise" wx:if="{{weeks.length}}">
      <view class="section-title">{{T.st_weekly}}</view>
      <view class="bars">
        <view class="bars__col" wx:for="{{weeks}}" wx:key="week">
          <view class="bars__num" wx:if="{{item.n}}">{{item.n}}</view>
          <view class="bars__track">
            <view class="bars__fill" style="height: {{item.pct}}%"></view>
          </view>
          <view class="bars__wk">{{item.week}}</view>
        </view>
      </view>
      <view class="bars__note">{{T.st_weekly_note}}</view>
    </view>

    <!-- 常用动作 -->
    <view class="card rise" wx:if="{{topExercises.length}}">
      <view class="section-title">{{T.st_top_ex}}</view>
      <view class="row ex__row" wx:for="{{topExercises}}" wx:key="exercise_id" wx:for-item="ex">
        <view class="ic ic-dumbbell row__ic"></view>
        <text class="row__label">{{ex.disp}}</text>
        <text class="row__value">{{ex.sets}} {{T.st_ex_sets}}</text>
      </view>
    </view>

    <!-- 体重 -->
    <view class="card rise">
      <view class="row wt__head">
        <view class="ic ic-activity row__ic"></view>
        <text class="row__label">{{T.st_weight}}</text>
        <block wx:if="{{weightLatest}}">
          <text class="row__value wt__latest">{{weightLatest}} kg</text>
          <text class="wt__delta {{weightDelta.indexOf('+') === 0 ? 'wt__delta--up' : 'wt__delta--dn'}}" wx:if="{{weightDelta}}">{{weightDelta}} kg ({{weightDeltaPct}})</text>
        </block>
      </view>
      <view class="wt__row">
        <input class="wt__input" type="digit" placeholder="{{T.st_weight_ph}}" placeholder-class="wt__ph" value="{{weightInput}}" bindinput="onWeightInput" />
        <button class="btn btn--accent wt__btn" size="mini" disabled="{{saving}}" bindtap="saveWeight">
          {{saving ? T.st_weight_saving : T.st_weight_save}}
        </button>
      </view>
      <!-- 目标体重 + 身高（同区，都进 /profile） -->
      <view class="wt__target">
        <view class="wt__target__row">
          <text class="wt__target__lb">{{T.st_weight_target}}</text>
          <input class="wt__input wt__target__input" type="digit" placeholder="{{T.st_weight_target_ph}}" placeholder-class="wt__ph"
            value="{{weightTarget}}" bindinput="onWeightTargetInput" bindblur="saveWeightTarget" />
        </view>
        <view class="wt__target__row">
          <text class="wt__target__lb">{{T.st_height}}</text>
          <input class="wt__input wt__target__input" type="digit" placeholder="{{T.st_height_ph}}" placeholder-class="wt__ph"
            value="{{height}}" bindinput="onHeightInput" bindblur="saveHeight" />
        </view>
        <view class="wt__target__diff" wx:if="{{weightTargetDiff}}">
          <text class="wt__delta {{weightTargetDiff.indexOf('+') === 0 ? 'wt__delta--up' : 'wt__delta--dn'}}">{{weightTargetDiff}}</text>
          <text class="wt__target__pct">({{weightTargetDiffPct}})</text>
        </view>
      </view>
      <!-- BMI -->
      <view class="bmi rise" wx:if="{{bmi}}">
        <text class="bmi__lb">{{T.st_bmi}}</text>
        <text class="bmi__val">{{bmi}}</text>
        <text class="bmi__tag">{{bmiLabel}}</text>
      </view>
      <view class="wt__note" wx:if="{{!weights.length}}">{{T.st_weight_empty}}</view>
    </view>
  </block>
</view>
