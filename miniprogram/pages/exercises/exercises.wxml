<view class="page-root {{dark?'dark':''}}">
  <view class="page">
  <view class="hero-t">{{i18n.exTitle}}</view>
  <view class="hero-s">{{i18n.exSub}}</view>

  <view class="search-card card">
    <input class="search" placeholder="{{i18n.exSearch}}" value="{{q}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <view class="chips">
    <view wx:for="{{muscles}}" wx:key="*this"
      class="chip {{muscle === item ? 'chip-on' : ''}}"
      data-m="{{item}}" bindtap="pickMuscle">{{muscleZh[item]}}</view>
  </view>

  <view class="list">
    <view class="card ex" wx:for="{{list}}" wx:key="id" data-ex="{{item}}" bindtap="showDetail">
      <view class="ex-top">
        <view class="ex-img" wx:if="{{item.img_url}}">
          <image src="{{item.img_url}}" mode="aspectFill" lazy-load="{{true}}"
            binderror="onImgErr" data-id="{{item.id}}" />
        </view>
        <view class="ex-body">
          <view class="ex-name">{{item.name_zh}}</view>
          <view class="ex-meta">{{item.equipment_zh}} · {{item.muscle_zh}} · {{item.cat_zh}}</view>
        </view>
      </view>
    </view>
    <view class="none" wx:if="{{!loading && !list.length}}">{{i18n.exNone}}</view>
  </view>

  <view class="sheet-mask" wx:if="{{detail}}" bindtap="closeSheet">
    <view class="sheet" catchtap="">
      <view class="sheet-t">{{detail.name_zh}}</view>
      <view class="sheet-video-wrap" wx:if="{{detail.clip_url && !clipErr[detail.id]}}">
        <video class="sheet-video"
          src="{{detail.clip_url}}" loop="{{true}}" controls="{{false}}"
          autoplay="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}"
          binderror="onClipErr" data-id="{{detail.id}}" />
      </view>
      <view class="sheet-video-wrap" wx:elif="{{detail.img_url && !imgErr[detail.id]}}">
        <image class="sheet-img" src="{{detail.img_url}}" mode="aspectFit" />
      </view>
      <view class="sheet-grid">
        <view class="sheet-cell"><view class="cell-lb">{{i18n.exEquip}}</view><view class="cell-val">{{detail.equipment_zh}}</view></view>
        <view class="sheet-cell"><view class="cell-lb">{{i18n.exMuscle}}</view><view class="cell-val">{{detail.muscle_zh}}</view></view>
        <view class="sheet-cell"><view class="cell-lb">{{i18n.exAssist}}</view><view class="cell-val">{{detail.muscles_zh}}</view></view>
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeSheet">{{i18n.exClose}}</button>
        <button class="fav-btn {{faved?'on':''}}" bindtap="toggleFav">{{faved ? i18n.exFaved : i18n.exFav}}</button>
      </view>
    </view>
  </view>
  </view>
</view>
