<view class="page page--tab {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_exercises" />
  <view class="hero hero--lead">
    <view class="hero__desc">{{T.ex_sub}}</view>
  </view>

  <view class="card search rise">
    <input class="search__input" placeholder="{{T.ex_ph}}" value="{{q}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- AI 生成计划入口 -->
  <button class="btn btn--accent btn--block rise" style="margin-bottom:var(--s-4)" bindtap="goForm">{{T.ex_ai_btn}}</button>

  <view class="chips" style="margin:var(--s-3) 0 var(--s-4)">
    <view wx:for="{{muscles}}" wx:key="*this"
      class="chip {{muscle === item ? 'chip--on' : ''}}"
      data-m="{{item}}" bindtap="pickMuscle">{{langEn ? item : muscleZh[item]}}</view>
  </view>

  <view class="list">
    <view class="card ex rise-item" wx:for="{{list}}" wx:key="id" data-ex="{{item}}" bindtap="showDetail">
      <view class="ex__row">
        <view class="ex__img" wx:if="{{item.img_url}}">
          <image src="{{item.img_url}}" mode="aspectFill" lazy-load="{{true}}"
            binderror="onImgErr" data-id="{{item.id}}" />
        </view>
        <view class="ex__body">
          <view class="ex__name">{{item.name_zh}}</view>
          <view class="ex__meta">{{item.equipment_zh}} · {{item.muscle_zh}} · {{item.cat_zh}}</view>
          <!-- 近期训练进度条（组数） -->
          <view class="ex__prog" wx:if="{{item._count}}">
            <text class="ex__prog-lb">{{T.ex_done_u}} {{item._count}}</text>
            <view class="ex__prog-track"><view class="ex__prog-fill" style="width: {{item._pct}}%"></view></view>
          </view>
        </view>
        <!-- 收藏按钮 -->
        <view class="ex__fav {{item._faved ? 'ex__fav--on' : ''}}" data-ex="{{item}}" catchtap="toggleListFav">
          <view class="ic {{item._faved ? 'ic-heart-fill' : 'ic-heart'}} ex__fav-ic"></view>
        </view>
        <view class="ic ic-chevron ex__arrow"></view>
      </view>
    </view>
    <view class="state" wx:if="{{!loading && !list.length}}">
      <view class="state__text">{{T.ex_none}}</view>
    </view>
  </view>

  <view class="sheet__mask" wx:if="{{detail}}" bindtap="closeSheet">
    <view class="sheet" catchtap="">
      <view class="sheet__t">{{detail.name_zh}}</view>
      <view class="sheet__media" wx:if="{{detail.clip_url && !clipErr[detail.id]}}">
        <video class="sheet__media-el"
          src="{{detail.clip_url}}" loop="{{true}}" controls="{{false}}"
          autoplay="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}"
          binderror="onClipErr" data-id="{{detail.id}}" />
      </view>
      <view class="sheet__media" wx:elif="{{detail.img_url && !imgErr[detail.id]}}">
        <image class="sheet__media-el" src="{{detail.img_url}}" mode="aspectFit" />
      </view>
      <view class="sheet__grid">
        <view class="sheet__cell"><view class="cell__lb">{{T.ex_equip}}</view><view class="cell__val">{{detail.equipment_zh}}</view></view>
        <view class="sheet__cell"><view class="cell__lb">{{T.ex_muscle}}</view><view class="cell__val">{{detail.muscle_zh}}</view></view>
        <view class="sheet__cell sheet__cell--wide"><view class="cell__lb">{{T.ex_assist}}</view><view class="cell__val">{{detail.muscles_zh}}</view></view>
      </view>
      <view class="sheet__acts">
        <button class="btn btn--ghost" style="flex:1" bindtap="closeSheet">{{T.ex_close}}</button>
        <view class="fav {{faved?'fav--on':''}}" style="flex:1" bindtap="toggleFav">{{faved ? T.ex_faved : T.ex_fav}}</view>
      </view>
    </view>
  </view>
</view>
