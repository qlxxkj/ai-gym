/* 动作页：颜色走 app.wxss 的 CSS 变量（.page-root），这里只写布局差异 */

.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-s { font-size: 26rpx; color: var(--text3); margin-top: 10rpx; margin-bottom: 32rpx; }

.search-card { padding: 12rpx; margin-bottom: 24rpx; }
.search {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text);
}

.chips { margin-bottom: 24rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; }

/* 列表项 */
.ex { padding: 20rpx 24rpx; }
.ex-top { display: flex; align-items: center; gap: 20rpx; }
.ex-img {
  width: 112rpx; height: 112rpx;
  border-radius: 20rpx; overflow: hidden;
  background: var(--accent-bg); flex-shrink: 0;
}
.ex-img image { width: 100%; height: 100%; }
.ex-body { flex: 1; min-width: 0; }
.ex-name { font-size: 30rpx; font-weight: 600; }
.ex-meta { font-size: 22rpx; color: var(--text3); margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.none { text-align: center; padding: 80rpx 0; color: var(--text3); font-size: 26rpx; }

/* 详情底部弹层 */
.sheet-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 99;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--card);
  color: var(--text);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 80rpx;
  box-sizing: border-box;
}
.sheet-t { font-size: 36rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }

.sheet-video-wrap {
  width: 100%; height: 400rpx;
  background: var(--text); border-radius: 20rpx;
  overflow: hidden; margin-bottom: 24rpx;
}
.sheet-video { width: 100%; height: 100%; }
.sheet-img { width: 100%; height: 100%; }

/* 信息网格 */
.sheet-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.sheet-cell {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
}
.cell-lb { font-size: 22rpx; color: var(--text3); margin-bottom: 8rpx; }
.cell-val { font-size: 26rpx; }

/* sheet 底部按钮 + 收藏 */
.sheet-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; }
.sheet-actions .btn { flex: 1; }
.fav-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx; font-weight: 600;
  background: var(--accent-bg); color: var(--accent);
}
.fav-btn.on { background: var(--accent); color: #fff; }
