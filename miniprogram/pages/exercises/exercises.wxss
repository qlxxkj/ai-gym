/* .hero/.card/.chips/.tag/.row/.state/.btn/.rise 已在 app.wxss，本页只写差异 */

/* 搜索 */
.search { padding: var(--s-2); }
.search__input {
  background: var(--fill);
  border-radius: var(--r-md);
  padding: 0 var(--s-3);
  height: 80rpx;
  font-size: var(--t-sm);
  color: var(--ink);
  box-sizing: border-box;
}

/* 列表 */
.list { display: flex; flex-direction: column; gap: var(--s-3); }
.ex { padding: 0 var(--s-4); }
.ex__row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: var(--s-3);
}
.ex__img {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--fill);
}
.ex__img image { width: 100%; height: 100%; display: block; }
.ex__body { flex: 1; min-width: 0; }
.ex__name { font-size: var(--t-body); font-weight: 600; }
.ex__meta {
  font-size: var(--t-cap);
  color: var(--ink-3);
  margin-top: var(--s-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ex__arrow { width: 32rpx; height: 32rpx; flex: none; }

/* 详情弹层：底部让出 tabBar 高度（tabBar 高 104rpx + 安全区），收藏按钮不被挡 */
.sheet__mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: var(--mask);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--card);
  color: var(--ink);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--s-5) var(--s-4) calc(var(--s-5) + 104rpx + env(safe-area-inset-bottom));
}
.sheet__t { font-size: var(--t-title); font-weight: 600; text-align: center; margin-bottom: var(--s-3); }
.sheet__media {
  width: 100%;
  height: 400rpx;
  background: var(--fill);
  border-radius: var(--r-md);
  overflow: hidden;
  margin-bottom: var(--s-3);
}
.sheet__media-el { width: 100%; height: 100%; display: block; }

/* 信息格 */
.sheet__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-2);
}
.sheet__cell {
  background: var(--fill);
  border-radius: var(--r-md);
  padding: var(--s-3);
}
.sheet__cell--wide { grid-column: 1 / -1; }
.cell__lb { font-size: var(--t-cap); color: var(--ink-3); margin-bottom: var(--s-1); }
.cell__val { font-size: var(--t-sm); color: var(--ink); word-break: break-all; }

/* 弹层底部：关闭 + 收藏 */
.sheet__acts { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-4); }
.fav {
  text-align: center;
  padding: 0 var(--s-5);
  border-radius: var(--r-md);
  font-size: var(--t-body);
  font-weight: 500;
  background: var(--accent-bg);
  color: var(--accent);
  transition: background var(--dur-1) var(--ease);
}
.fav--on { background: var(--accent); color: var(--on-solid); }
