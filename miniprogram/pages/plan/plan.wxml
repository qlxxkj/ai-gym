<view class="page page--tab {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_plan" />
  <block wx:if="{{pending}}">
    <view class="state"><view class="state__text">{{T.plan_loading}}</view></view>
  </block>

  <block wx:elif="{{loadErr}}">
    <view class="state">
      <view class="state__text">{{T.plan_load_err}}：{{loadErr}}</view>
    </view>
  </block>

  <block wx:elif="{{!current}}">
    <block wx:if="{{!plans.length}}">
      <view class="hero">
        <view class="hero__title">{{T.nav_plan}}</view>
        <view class="hero__desc">{{T.plan_no_s}}</view>
      </view>
      <button class="btn btn--accent btn--block pick rise" bindtap="goForm">{{T.plan_new}}</button>
    </block>
    <block wx:else>
      <view class="hero hero--lead">
        <view class="hero__desc">{{T.plan_no_s}}</view>
      </view>
      <view class="card group">
        <view class="row" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlan">
          <view class="ic ic-book row__ic"></view>
          <text class="row__label">{{item.title}}</text>
          <text class="row__value">{{T.plan_goal}} {{item.goal}}</text>
          <view class="ic ic-chevron row__arrow"></view>
        </view>
        <view class="hr"></view>
        <view class="row" bindtap="goForm">
          <view class="ic ic-plus ic--acc row__ic"></view>
          <text class="row__label" style="color:var(--accent);font-weight:500">{{T.plan_new2}}</text>
          <view class="ic ic-chevron row__arrow"></view>
        </view>
      </view>
    </block>
  </block>

  <block wx:else>
    <view class="hero hero--lead">
      <view class="hero__title" style="font-size:var(--t-title);letter-spacing:2rpx">{{current.title}}</view>
      <view class="hero__desc" style="white-space:normal;margin-top:var(--s-2)">{{current.plan_data.summary}}</view>
    </view>

    <view class="card tips rise" wx:if="{{!langEn && current.plan_data.tips.length}}" style="margin-bottom:var(--s-4)">
      <view class="section-title">{{T.plan_tips}}</view>
      <view class="tip" wx:for="{{current.plan_data.tips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="chips rise" style="margin-bottom:var(--s-4)">
      <text class="tag tag--accent">{{curGoal}}</text>
      <text class="tag">{{T.plan_rest_lb}} {{current.plan_data.rest_seconds}}{{T.plan_rest_s}}</text>
      <text class="tag">{{T.plan_v}} {{current.version}}</text>
      <view style="flex:1"></view>
      <view class="fav {{faved?'fav--on':''}}" bindtap="toggleFav">
        <view class="ic {{faved ? 'ic-heart-fill' : 'ic-heart'}} {{faved?'ic--acc':''}} fav__ic"></view>
        <text class="fav__t">{{faved ? T.fav_on : T.fav_off}}</text>
      </view>
    </view>

    <view class="card day rise-item" wx:for="{{current.plan_data.days}}" wx:for-item="day" wx:key="day">
      <view class="row day__head" data-d="{{day.day}}" bindtap="toggleDay">
        <view class="ic ic-calendar row__ic"></view>
        <text class="row__label">{{T.plan_day}} {{day.day}}{{T.plan_day_suf}}</text>
        <text class="row__value">{{day.label}}</text>
        <view class="ic {{openDay === day.day ? 'ic-minus' : 'ic-plus'}} row__arrow"></view>
      </view>
      <view class="day__body" wx:if="{{openDay === day.day}}">
        <view class="ex" wx:for="{{day.exercises}}" wx:for-item="ex" wx:key="id">
          <view class="ex__top">
            <video wx:if="{{ex.clip_url}}" class="ex__media" src="{{ex.clip_url}}" loop="{{true}}"
              controls="{{false}}" autoplay="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}"></video>
            <image wx:elif="{{ex.img_url}}" class="ex__media" src="{{ex.img_url}}" mode="aspectFill"></image>
            <view class="ex__name">{{ex.name_zh}}</view>
          </view>
          <view class="ex__set" wx:for="{{ex.sets}}" wx:for-item="st" wx:key="index">
            {{T.plan_day}} {{index + 1}} {{T.plan_set}} · {{st.reps}} {{T.plan_reps}} · {{st.rest_seconds}} {{T.plan_rest_s}}
          </view>
          <view class="ex__note" wx:if="{{ex.note}}">{{ex.note}}</view>
        </view>
      </view>
    </view>

    <view class="card tips rise-item" wx:if="{{current.plan_data.tips.length}}" style="margin-top:var(--s-4)">
      <view class="section-title">{{T.plan_tips}}</view>
      <view class="tip" wx:for="{{current.plan_data.tips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="card review" wx:if="{{showReviewPanel}}" style="margin-top:var(--s-4)">
      <view class="review__head">
        <view class="section-title" style="margin-bottom:var(--s-1)">{{T.plan_review}}</view>
        <view class="review__close" bindtap="dismissReview">{{T.plan_review_close}}</view>
      </view>
      <view class="review__pre">{{reviewText}}</view>
      <button class="btn btn--accent btn--block" disabled="{{applying}}" bindtap="applyReview">
        {{applying ? T.plan_apply_ing : T.plan_apply}}
      </button>
    </view>

    <view class="actions">
      <button class="btn btn--accent btn--block" bindtap="doReview" disabled="{{reviewing}}">
        {{reviewing ? T.plan_reviewing : T.plan_do_review}}
      </button>
      <button class="btn btn--ghost btn--block" style="margin-top:var(--s-2)" bindtap="doRevise" disabled="{{revising}}">
        {{T.plan_revise}}
      </button>
      <button class="btn btn--ghost btn--block" style="margin-top:var(--s-2)" bindtap="goForm">
        {{T.plan_new2}}
      </button>
    </view>
  </block>
</view>
