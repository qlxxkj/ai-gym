<view class="page-root {{dark?'dark':''}}">
  <view class="page">
  <block wx:if="{{pending}}">
    <view class="loading">{{i18n.planLoading}}</view>
  </block>
  <block wx:elif="{{loadErr}}">
    <view class="empty">
      <view class="empty-t">{{i18n.planLoadErrT}}</view>
      <view class="empty-s">{{loadErr}}</view>
    </view>
  </block>

  <block wx:elif="{{!current}}">
    <view class="empty" wx:if="{{!plans.length}}">
      <view class="empty-t">{{i18n.planNoPlanT}}</view>
      <view class="empty-s">{{i18n.planNoPlanS}}</view>
      <button class="btn btn-accent new-btn" bindtap="goForm">{{i18n.planNew}}</button>
    </view>
    <block wx:else>
      <view class="hero">
        <view class="hero-t">{{i18n.planTitle}}</view>
        <view class="hero-actions"><text class="new-link" bindtap="goForm">{{i18n.planNew}}</text></view>
      </view>
      <view class="card" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlan">
        <view class="card-title">{{item.title}}</view>
        <view class="card-meta">{{i18n.planGoal}} {{item.goal}} · {{i18n.planVersion}} {{item.version}}</view>
      </view>
    </block>
  </block>

  <block wx:else>
    <view class="hero">
      <view class="hero-t">{{current.title}}</view>
      <view class="hero-s">{{current.plan_data.summary}}</view>
      <view class="hero-meta">
        <text class="tag">{{current.goal}}</text>
        <text class="tag">{{i18n.planRest}} {{current.plan_data.rest_seconds}} {{i18n.planSetItemSec}}</text>
        <text class="tag">{{i18n.planVersion}} {{current.version}}</text>
      </view>
      <view class="hero-act">
        <text class="fav {{faved?'on':''}}" bindtap="toggleFav">{{faved ? i18n.planFaved : i18n.planFav}}</text>
        <text class="new-link" bindtap="goForm">{{i18n.planNew}}</text>
      </view>
    </view>

    <view class="card day" wx:for="{{current.plan_data.days}}" wx:for-item="day" wx:key="day">
      <view class="day-head" data-d="{{day.day}}" bindtap="toggleDay">
        <view class="day-lb">{{i18n.planDay}} {{day.day}} {{i18n.planDaySuffix}}</view>
        <view class="day-label">{{day.label}}</view>
        <view class="day-arrow">{{openDay === day.day ? '−' : '＋'}}</view>
      </view>
      <view class="day-body" wx:if="{{openDay === day.day}}">
        <view class="ex" wx:for="{{day.exercises}}" wx:for-item="ex" wx:key="id">
          <view class="ex-top">
            <video wx:if="{{ex.clip_url}}" class="ex-media" src="{{ex.clip_url}}" loop="{{true}}"
              controls="{{false}}" autoplay="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}"></video>
            <image wx:elif="{{ex.img_url}}" class="ex-media" src="{{ex.img_url}}" mode="aspectFill"></image>
            <view class="ex-name">{{ex.name_zh}}</view>
          </view>
          <view class="ex-set" wx:for="{{ex.sets}}" wx:for-item="st" wx:key="index">
            {{i18n.planDay}} {{index + 1}} {{i18n.planSets}} · {{st.reps}} {{i18n.planSetItem}} {{st.rest_seconds}} {{i18n.planSetItemSec}}
          </view>
          <view class="ex-note" wx:if="{{ex.note}}">{{ex.note}}</view>
        </view>
      </view>
    </view>

    <view class="card tips" wx:if="{{current.plan_data.tips.length}}">
      <view class="sec-t">{{i18n.planTips}}</view>
      <view class="tip" wx:for="{{current.plan_data.tips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="card review" wx:if="{{showReviewPanel}}">
      <view class="review-head">
        <view class="sec-t" style="margin-bottom:8rpx">{{i18n.planReview}}</view>
        <view class="review-close" bindtap="dismissReview">{{i18n.planReviewClose}}</view>
      </view>
      <view class="review-pre">{{reviewText}}</view>
      <button class="btn btn-accent" style="margin-top:8rpx" disabled="{{applying}}" bindtap="applyReview">
        {{applying ? i18n.planApplyIng : i18n.planApply}}
      </button>
    </view>

    <view class="actions">
      <button class="btn btn-accent" bindtap="doReview" disabled="{{reviewing}}">{{reviewing ? i18n.planReviewing : i18n.planDoReview}}</button>
      <button class="btn btn-ghost" bindtap="doRevise" disabled="{{revising}}">{{i18n.planRevise}}</button>
    </view>
  </block>
  </view>
</view>
