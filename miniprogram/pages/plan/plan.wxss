/* .hero/.card/.row/.chips/.state/.section-title/.btn 已在 app.wxss，本页只写差异 */

/* 天数卡 */
.card.day { padding: 0 var(--s-4); }
.day__head { border-radius: var(--r-lg); }
.day__body { padding: 0 0 var(--s-3); }

/* 动作块 */
.ex {
  padding: var(--s-3) 0;
  border-top: 1rpx solid var(--line);
}
.ex:first-child { border-top: none; }
.ex__top {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-bottom: var(--s-2);
}
.ex__media {
  width: 128rpx;
  height: 96rpx;
  flex: none;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--fill);
}
.ex__media image, .ex__media video { width: 100%; height: 100%; display: block; }
.ex__name { font-size: var(--t-sm); font-weight: 600; min-width: 0; }
.ex__set { font-size: var(--t-cap); color: var(--ink-2); margin-top: var(--s-1); }
.ex__note { font-size: var(--t-cap); color: var(--ink-3); margin-top: var(--s-2); line-height: 1.6; }

/* 收藏标记：心形图标 + 文字 */
.fav { display: inline-flex; align-items: center; gap: var(--s-1); font-size: var(--t-cap); color: var(--ink-3); }
.fav--on { color: var(--accent); }
.fav__ic { width: 28rpx; height: 28rpx; }

/* 教练提示 */
.card.tips { padding: var(--s-4); }
.tip { font-size: var(--t-sm); color: var(--ink-2); line-height: 1.7; margin-top: var(--s-2); }
.tip:first-child { margin-top: 0; }

/* 复盘面板 */
.card.review { padding: var(--s-4); }
.review__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.review__close {
  font-size: var(--t-cap);
  color: var(--ink-3);
}
.review__pre {
  margin: var(--s-3) 0;
  padding: var(--s-3);
  background: var(--fill);
  border-radius: var(--r-md);
  font-size: var(--t-cap);
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 600rpx;
  overflow: auto;
  line-height: 1.7;
}

/* 底部操作 */
.actions { margin-top: var(--s-5); }
