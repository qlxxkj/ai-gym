.page { padding: 24rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-t { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty-s { font-size: 26rpx; color: #8a7d75; margin-bottom: 32rpx; }
.go { background: #A5492B; color: #fff; border-radius: 12rpx; font-size: 28rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; }
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.card-meta { font-size: 24rpx; color: #8a7d75; }

.head { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.head-t { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.head-s { font-size: 26rpx; color: #5c504a; line-height: 1.5; margin-bottom: 8rpx; }
.head-goal { font-size: 24rpx; color: #A5492B; }

.day { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; }
.day-head { display: flex; align-items: center; justify-content: space-between; }
.day-lb { font-size: 30rpx; font-weight: 600; }
.day-arrow { font-size: 24rpx; color: #A5492B; }
.ex { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #f0e9e2; }
.ex-name { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.ex-set { font-size: 24rpx; color: #5c504a; margin-bottom: 4rpx; }
.ex-note { font-size: 22rpx; color: #8a7d75; margin-top: 6rpx; }

.tips { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.tips-t { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.tip { font-size: 24rpx; color: #5c504a; line-height: 1.6; margin-bottom: 8rpx; }

.review-block { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.review-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.review-t { font-size: 28rpx; font-weight: 600; color: #A5492B; }
.review-close { font-size: 24rpx; color: #8a7d75; }
.review-pre { font-size: 22rpx; color: #5c504a; white-space: pre-wrap; word-break: break-all; margin-bottom: 16rpx; }
.review-apply { background: #A5492B; color: #fff; border-radius: 12rpx; font-size: 26rpx; margin-top: 8rpx; }

.actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 12rpx; }
.btn { background: #241D1B; color: #fff; border-radius: 16rpx; font-size: 28rpx; }
.btn-ghost { background: #fff; color: #241D1B; border: 2rpx solid #e5ddd6; }
.btn[disabled] { opacity: 0.6; }
