/* 计划页：统一设计系统（见 app.wxss），本页只写差异 */

/* 大标题区 */
.hero { margin-bottom: 32rpx; }
.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-s { font-size: 26rpx; color: #6E625B; margin-top: 14rpx; line-height: 1.7; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.tag {
  font-size: 22rpx; color: #B0532E;
  background: #F7E7DE; border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* 计划列表（多计划时） */
.card { padding: 28rpx 32rpx; }
.card-title { font-size: 32rpx; font-weight: 600; }
.card-meta { font-size: 24rpx; color: #A2968D; margin-top: 8rpx; }

/* 天数 */
.day-head { display: flex; align-items: center; gap: 16rpx; }
.day-lb { font-size: 30rpx; font-weight: 700; }
.day-label { font-size: 24rpx; color: #A2968D; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.day-arrow { font-size: 24rpx; color: #B0532E; }
.day-body { margin-top: 24rpx; }

/* 动作卡片 */
.ex { padding: 20rpx 0; border-top: 2rpx solid #EAE3DC; }
.ex:first-child { border-top: none; }
.ex-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 12rpx; }
.ex-media {
  width: 108rpx; height: 108rpx;
  border-radius: 20rpx; overflow: hidden;
  background: #F4F0EA; flex-shrink: 0;
}
.ex-media image { width: 100%; height: 100%; }
.ex-name { font-size: 30rpx; font-weight: 600; }
.ex-set { font-size: 24rpx; color: #6E625B; margin-bottom: 4rpx; }
.ex-note { font-size: 22rpx; color: #A2968D; margin-top: 8rpx; line-height: 1.6; }

/* 教练提示 */
.tip { font-size: 26rpx; color: #6E625B; line-height: 1.8; margin-bottom: 10rpx; }
.tip:last-child { margin-bottom: 0; }

/* 复盘 */
.review-head { display: flex; justify-content: space-between; align-items: center; }
.review-close { font-size: 24rpx; color: #A2968D; }
.review-pre {
  font-size: 24rpx; color: #6E625B;
  white-space: pre-wrap; word-break: break-all;
  margin: 12rpx 0 16rpx; line-height: 1.8;
  max-height: 600rpx; overflow: auto;
}

/* 底部按钮 */
.actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 8rpx; }
