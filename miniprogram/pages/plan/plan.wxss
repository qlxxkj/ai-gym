/* 计划页：颜色走 app.wxss 的 CSS 变量（.page-root），这里只写布局差异 */

/* 大标题区 */
.hero { margin-bottom: 32rpx; }
.hero-t { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-s { font-size: 26rpx; color: var(--text2); margin-top: 14rpx; line-height: 1.7; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.tag {
  font-size: 22rpx; color: var(--accent);
  background: var(--accent-bg); border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.hero-act { display: flex; gap: 28rpx; margin-top: 28rpx; align-items: center; }
.hero-actions { margin-top: 20rpx; }
.fav { font-size: 26rpx; color: var(--text3); }
.fav.on { color: var(--accent); }
.new-link { font-size: 26rpx; color: var(--accent); }
.new-btn { width: 280rpx; margin: 32rpx auto 0; }

/* 计划列表（多计划时） */
.card { padding: 28rpx 32rpx; }
.card-title { font-size: 32rpx; font-weight: 600; }
.card-meta { font-size: 24rpx; color: var(--text3); margin-top: 8rpx; }

/* 天数 */
.day-head { display: flex; align-items: center; gap: 16rpx; }
.day-lb { font-size: 30rpx; font-weight: 700; }
.day-label { font-size: 24rpx; color: var(--text3); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.day-arrow { font-size: 24rpx; color: var(--accent); }
.day-body { margin-top: 24rpx; }

/* 动作卡片 */
.ex { padding: 20rpx 0; border-top: 2rpx solid var(--line); }
.ex:first-child { border-top: none; }
.ex-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 12rpx; }
.ex-media {
  width: 108rpx; height: 108rpx;
  border-radius: 20rpx; overflow: hidden;
  background: var(--accent-bg); flex-shrink: 0;
}
.ex-media image { width: 100%; height: 100%; }
.ex-name { font-size: 30rpx; font-weight: 600; }
.ex-set { font-size: 24rpx; color: var(--text2); margin-bottom: 4rpx; }
.ex-note { font-size: 22rpx; color: var(--text3); margin-top: 8rpx; line-height: 1.6; }

/* 教练提示 */
.tip { font-size: 26rpx; color: var(--text2); line-height: 1.8; margin-bottom: 10rpx; }
.tip:last-child { margin-bottom: 0; }

/* 复盘 */
.review-head { display: flex; justify-content: space-between; align-items: center; }
.review-close { font-size: 24rpx; color: var(--text3); }
.review-pre {
  font-size: 24rpx; color: var(--text2);
  white-space: pre-wrap; word-break: break-all;
  margin: 12rpx 0 16rpx; line-height: 1.8;
  max-height: 600rpx; overflow: auto;
}

/* 底部按钮 */
.actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 8rpx; }
