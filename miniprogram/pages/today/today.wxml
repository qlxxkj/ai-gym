<view class="page page--tab {{theme === 'dark' ? 't-dark' : ''}}">
  <topbar tkey="tab_today" />

  <block wx:if="{{loading}}">
    <view class="state"><view class="state__text">{{T.loading}}</view></view>
  </block>

  <block wx:elif="{{!planRaw}}">
    <view class="hero">
      <view class="hero__title">{{T.today_hi}}</view>
      <view class="hero__desc">{{T.today_no_plan}}</view>
    </view>
    <button class="btn btn--accent btn--block" bindtap="goPlan">{{T.today_go_plan}}</button>
  </block>

  <block wx:else>
    <view class="hero hero--lead">
      <view class="hero__title" style="font-size:var(--t-title);letter-spacing:2rpx">{{restDay ? T.today_q_daily : dayLabel}}</view>
      <view class="hero__desc">{{today}} · {{T.today_from}} {{planTitle}}</view>
    </view>

    <!-- 预计量 / 恢复环 / 动作数 -->
    <view class="card rise today__est" wx:if="{{totalSets}}">
      <view class="today__est-cell">
        <view class="today__est-num">{{estMin}}</view>
        <view class="today__est-lb">{{T.today_est}} {{T.today_est_min}}</view>
      </view>
      <view class="today__est-cell">
        <view class="today__est-num">{{totalEx}}</view>
        <view class="today__est-lb">{{T.today_ex_u}}</view>
      </view>
      <view class="today__recov">
        <view class="recov-ring" style="--pct:{{recover}}">
          <view class="recov-ring__num">{{recover}}</view>
        </view>
        <view class="recov-lb {{recoverLb === 'good' ? 'recov-lb--good' : recoverLb === 'low' ? 'recov-lb--low' : ''}}">
          {{T.today_recover}} · {{T['recover_' + recoverLb]}}
        </view>
      </view>
    </view>

    <!-- AI 教练一句话（规则可解释，不用模型） -->
    <view class="card rise coach" wx:if="{{coachTip || coachTipKey}}">
      <view class="coach__head">
        <view class="ic ic-target coach__ic"></view>
        <text class="coach__lb">{{T.today_coach}}</text>
      </view>
      <view class="coach__tip">{{coachTip || T[coachTipKey]}}</view>
    </view>

    <!-- 周进度 -->
    <view class="card rise" wx:if="{{weekGoal}}">
      <view class="row prog__head">
        <view class="ic ic-target row__ic"></view>
        <text class="row__label">{{T.week_progress}}</text>
        <text class="row__value">{{weekDone}}/{{weekGoal}}</text>
      </view>
      <view class="prog__bar">
        <view class="prog__fill" style="width: {{weekPct}}%"></view>
      </view>
    </view>

    <!-- 组间休息倒计时 -->
    <view class="rest rise" wx:if="{{restLeft > 0}}">
      <view class="rest__lb">{{T.today_rest}}</view>
      <view class="rest__num">{{restLeft}}</view>
      <view class="rest__bar"><view class="rest__fill" style="width: {{restLeft / restTotal * 100}}%"></view></view>
    </view>

    <!-- 全部完成打卡 -->
    <view class="done rise" wx:if="{{allDone}}" bindtap="markAllDone">{{T.today_all_done}}</view>

    <!-- 动作列表 -->
    <view class="card ex rise-item" wx:for="{{exercises}}" wx:for-item="ex" wx:for-index="exidx" wx:key="id">
      <!-- 首屏只放静态图；多路 mp4 并发自动播放会把整页拖死，点按才起视频 -->
      <image wx:if="{{!playVid[ex.id] && ex.img_url}}" class="ex__media" src="{{ex.img_url}}" mode="aspectFill"
        catchtap="{{ex.clip_url ? 'playVidTap' : ''}}" data-ex="{{ex.id}}"></image>
      <video wx:if="{{playVid[ex.id] && ex.clip_url}}" class="ex__media" src="{{ex.clip_url}}"
        loop="{{true}}" controls="{{false}}" autoplay="{{true}}" muted="{{true}}"
        show-center-play-btn="{{false}}" object-fit="cover"></video>
      <view class="ex__head">
        <text class="ex__name">{{ex.name_zh}}</text>
        <text class="ex__count">{{ex.sets.length}} {{T.today_sets_u}}</text>
        <view class="ex__fav {{ex.faved ? 'ex__fav--on' : ''}}" data-ex="{{ex}}" bindtap="toggleExFav">
          <view class="ic {{ex.faved ? 'ic-heart-fill' : 'ic-heart'}} {{ex.faved ? 'ic--acc' : ''}} ex__fav-ic"></view>
        </view>
      </view>
      <view class="ex__note" wx:if="{{ex.note}}">{{ex.note}}</view>
      <view class="ex__last" wx:if="{{ex.last && ex.last.weight}}">
        <text>{{T.last_w}} {{ex.last.weight}}kg · {{ex.last.reps}}{{T.today_reps_u}}</text>
      </view>
      <view class="set" wx:for="{{ex.sets}}" wx:for-item="st" wx:for-index="setidx" wx:key="*this">
        <text class="set__lb">{{T.today_set}} {{setidx + 1}}</text>
        <text class="set__detail">{{st.reps}} {{T.today_reps_u}} · {{T.today_rest_u}} {{st.rest_seconds}} {{T.today_sec_u}}</text>
        <view class="set__rpe {{rpe[ex.id + ':' + (setidx + 1)] ? 'set__rpe--on' : ''}}" wx:if="{{ex.setStates[setidx]}}"
          data-key="{{ex.id + ':' + (setidx + 1)}}" bindtap="toggleRpePicker">
          <text>{{rpe[ex.id + ':' + (setidx + 1)] || T.rpe_lb}}</text>
        </view>
        <view class="set__check {{ex.setStates[setidx] ? 'set__check--on' : ''}}"
          data-exidx="{{exidx}}" data-setidx="{{setidx}}" bindtap="toggleSet">
          {{ex.setStates[setidx] ? '✓' : '○'}}
        </view>
      </view>
      <!-- RPE 快选（6-10），作用于当前展开组 -->
      <view class="rpe" wx:if="{{rpeOpen}}">
        <text class="rpe__lb">{{T.rpe_lb}}</text>
        <view class="rpe__pick {{rpe[rpeOpen] === (i + 6) ? 'rpe__pick--on' : ''}}"
          wx:for="{{[0,1,2,3,4]}}" wx:for-item="i" wx:key="*this"
          data-key="{{rpeOpen}}" data-v="{{i + 6}}" bindtap="pickRpe">{{i + 6}}</view>
      </view>
    </view>

    <!-- 近 7 天训练量 -->
    <view class="card rise" wx:if="{{sets7}}">
      <view class="row">
        <view class="ic ic-activity row__ic"></view>
        <text class="row__label">{{T.today_sets7}}</text>
        <text class="row__value">{{sets7}}</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick">
      <view class="quick__item" bindtap="goDaily">
        <view class="ic ic-calendar quick__ic"></view>
        <text>{{T.today_q_daily}}</text>
      </view>
      <view class="quick__item" bindtap="goExercises">
        <view class="ic ic-dumbbell quick__ic"></view>
        <text>{{T.today_q_ex}}</text>
      </view>
      <view class="quick__item" bindtap="goStats">
        <view class="ic ic-list quick__ic"></view>
        <text>{{T.today_q_stats}}</text>
      </view>
    </view>
  </block>
</view>
