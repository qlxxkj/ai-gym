/* 自带 token：样式隔离下拿不到页面的主题变量，由 theme 属性切换整套色值 */
.tb {
    --card: #FEFCFC;
    --line: #EAE5E3;
    --ink-3: #766D6A;
    --accent: #059E58;

    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: var(--card);
    box-shadow: 0 -1rpx 0 var(--line);
}
.tb--dark {
    --card: #211D1C;
    --line: #373230;
    --ink-3: #B2AAA8;
    --accent: #00E08A;
}
.tb--ai {
    --card: #17191F;
    --line: #262A33;
    --ink-3: #9AA0A8;
    --accent: #00E08A;
}

.tb__inner {
    display: flex;
    height: 104rpx;
}
.tb__item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4rpx;
    padding: 8rpx 0;
}
.tb__text {
    font-size: 24rpx;
    font-weight: 500;
    color: var(--ink-3);
    transition: color 120ms cubic-bezier(0.25, 1, 0.5, 1);
}
.tb__item--on .tb__text { color: var(--accent); font-weight: 600; }

.tb__safe {
    height: env(safe-area-inset-bottom);
}
/* tab 图标（组件样式隔离，mask 本地写死） */
.tb__ic{--ic:var(--ink-3);background-color:var(--ic);-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;-webkit-mask-size:100% 100%;mask-size:100% 100%;width:40rpx;height:40rpx;flex:none}
.ic-user{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-dumbbell{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-calendar{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-clipboard{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-check{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-chart{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.tb__item--on .tb__ic{--ic:var(--accent)}
